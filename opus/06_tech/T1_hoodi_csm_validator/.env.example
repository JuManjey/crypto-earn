# Скопируйте в .env и заполните. В .env нет секретов: JWT лежит в secrets/jwt.hex,
# пароли keystore вводятся интерактивно при импорте ключей.

# Версии проверены по GitHub Releases и Docker Hub на 2026-11-08.
# Перед запуском сверьте свежие релизы: scripts/check_client_updates.sh
NETHERMIND_VERSION=2.2.2
LIGHTHOUSE_VERSION=v8.3.2
MEVBOOST_VERSION=1.12

# Публичные checkpoint-sync эндпоинты Hoodi: https://eth-clients.github.io/checkpoint-sync-endpoints/
# После синхронизации сверьте finalized root минимум с двумя другими провайдерами из списка.
CHECKPOINT_SYNC_URL=https://checkpoint-sync.hoodi.ethpandaops.io

# Lido CSM на Hoodi требует feeRecipient = Lido Execution Layer Rewards Vault.
# Адрес ниже взят с https://operatorportal.lido.fi/modules/community-staking-module (2026-11-08);
# перед использованием проверьте его на официальной странице: адреса меняются, а фишинговые копии существуют.
FEE_RECIPIENT=0x9b108015fe433F173696Af3Aa0CF7CDb3E104258

# Список релеев Hoodi берите только из официального allowlist Lido:
# https://operatorportal.lido.fi/public/relay-maintenance-committee/mev-boost-relays
# (или метод get_relays() контракта MevBoostRelayAllowedList). Формат: https://PUBKEY@host,https://PUBKEY@host
MEV_RELAYS=

GRAFFITI=

EL_P2P_PORT=30303
CL_P2P_PORT=9000
CL_QUIC_PORT=9001
ETH_NETWORK_NAME=hoodi-csm-net
